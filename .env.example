# Copy to .env and fill in (on Windows, .\jobhunt setup does this for you). Never commit .env.
# Keep comments on their own lines: Docker Compose reads "KEY=   # note" as the value "# note".

# Claude: leave empty and do the one-time login (Pi: docker compose run --rm hunt claude, Windows:
# .\jobhunt login-claude), then type /login. Recommended: the login also brings your claude.ai Gmail
# connector. Or paste a token from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# Password for the sign-in screen (noVNC, port 6080) used to sign in to LinkedIn/Seek once
VNC_PASSWORD=

# Vercel tracker
# Token: vercel.com -> Account Settings -> Tokens
VERCEL_TOKEN=
# What you type to open the tracker
TRACKER_PASSWORD=
# Any long random string; the loop uses it to read approvals
PI_SYNC_TOKEN=
# Production URL, e.g. https://zeel-jobhunt-tracker.vercel.app (after vercel-init)
TRACKER_URL=
VERCEL_PROJECT_NAME=zeel-jobhunt-tracker
